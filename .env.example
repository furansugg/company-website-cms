# Copy to .env and edit before running `docker compose up`.

# JWT signing secret (HS256). MUST be at least 64 characters in production.
JWT_SECRET=change-me-please-this-is-a-development-secret-key-must-be-long-enough-for-hs256

# Comma-separated list of origins allowed to call the backend API.
# Wildcards are supported (e.g. http://localhost:* matches any local port).
# In production, replace this with explicit, comma-separated origins (e.g. https://example.com).
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
